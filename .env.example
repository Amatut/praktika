# Настройки адаптера наставника (npm run coach). Подробно — docs/coach.md.
# Скопируй этот файл в .env и заполни нужное. Файл .env не попадает в git.
# Пустое значение = значение по умолчанию. Никому не показывай ключ API.

# anthropic — настоящий ИИ (платно); mock — проверка связи без ИИ (бесплатно). По умолчанию anthropic.
COACH_PROVIDER=

# Ключ API из Claude Console (раздел API Keys). Хранится только здесь, в приложение не попадает.
ANTHROPIC_API_KEY=

# Модель. По умолчанию claude-opus-5. Дешевле: claude-sonnet-5, claude-haiku-4-5.
COACH_MODEL=

# Глубина рассуждений модели: low (по умолчанию), medium, high. Выше — дороже и дольше.
COACH_EFFORT=

# Адрес и порт адаптера. По умолчанию 127.0.0.1 и 8787 (только этот компьютер).
COACH_HOST=
COACH_PORT=

# Токен доступа к адаптеру (не ключ API!), не короче 32 символов.
# Обязателен, если COACH_HOST не 127.0.0.1 или адаптер открыт через HTTPS-прокси.
COACH_ACCESS_TOKEN=

# Адреса приложения через запятую. По умолчанию:
# http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
COACH_ALLOWED_ORIGINS=

# Запросов к ИИ за 10 минут (20) и за сутки (100).
COACH_RATE_LIMIT=
COACH_DAILY_LIMIT=

# Максимальная длина ответа в токенах, включая рассуждения модели (600; для «Подробнее» — вдвое больше).
COACH_MAX_TOKENS=
# Сколько адаптер ждёт ответа ИИ, в миллисекундах: от 1000 до 30000 (по умолчанию 30000).
COACH_TIMEOUT_MS=
